app_name = "Bond Trading"
environment = "development"
timezone = "Europe/Moscow"

[database]
url = "postgresql+asyncpg://bond_trading:change-me-local@127.0.0.1:5432/bond_trading"
echo = false

[moex]
base_url = "https://iss.moex.com/iss"
passport_auth_url = "https://passport.moex.com/authenticate"
require_auth = false
timeout_seconds = 10.0
retries = 3
concurrency = 5
reference_ttl_seconds = 21600
market_ttl_seconds = 900
user_agent = "bond-trading/0.1"

[imports]
max_upload_bytes = 10485760
preview_ttl_seconds = 1800

[storage]
endpoint = "127.0.0.1:9000"
access_key = "bond-trading"
secret_key = "change-me-minio"
bucket = "bond-trading-uploads"
secure = false
region = "us-east-1"

[auth]
session_ttl_seconds = 604800
session_cookie_name = "bond_trading_session"
csrf_cookie_name = "bond_trading_csrf"
secure_cookies = false
bootstrap_admin_username = "admin"
bootstrap_admin_email = "admin@bond-trading.local"
bootstrap_user1_username = "user1"
bootstrap_user1_email = "user1@bond-trading.local"
bootstrap_user2_username = "user2"
bootstrap_user2_email = "user2@bond-trading.local"

[google_sheets]
enabled = false
credentials_file = "secrets/google-service-account.json"
api_base_url = "https://sheets.googleapis.com/v4"
timeout_seconds = 15.0
retries = 3
worker_poll_seconds = 5.0
default_sync_interval_seconds = 300

[logging]
level = "INFO"
