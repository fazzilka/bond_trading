app_name = "Bond Trading"
environment = "development"
timezone = "Europe/Moscow"

[database]
url = "postgresql+asyncpg://bond_trading:change-me-local@127.0.0.1:5432/bond_trading"
echo = false

[moex]
base_url = "https://iss.moex.com/iss"
timeout_seconds = 10.0
retries = 3
concurrency = 5
reference_ttl_seconds = 21600
market_ttl_seconds = 900
user_agent = "bond-trading/0.1"

[imports]
max_upload_bytes = 10485760
preview_ttl_seconds = 1800

[logging]
level = "INFO"
