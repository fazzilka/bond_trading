POSTGRES_USER=bond_trading
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=bond_trading
MINIO_ROOT_USER=bond-trading
MINIO_ROOT_PASSWORD=change-me-minio

# Required. Generate unique values, for example: openssl rand -base64 48
BOND_TRADING__AUTH__BOOTSTRAP_ADMIN_PASSWORD=
BOND_TRADING__AUTH__BOOTSTRAP_USER1_PASSWORD=
BOND_TRADING__AUTH__BOOTSTRAP_USER2_PASSWORD=

# Public delayed ISS works with these fields empty.
# For a subscribed MOEX Passport account, fill both and set REQUIRE_AUTH=true.
BOND_TRADING__MOEX__PASSPORT_LOGIN=
BOND_TRADING__MOEX__PASSPORT_PASSWORD=
BOND_TRADING__MOEX__REQUIRE_AUTH=false
